import re
import json
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import HTMLResponse, FileResponse
from pydantic import BaseModel
import httpx

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

class VideoRequest(BaseModel):
    url: str

@app.get("/", response_class=HTMLResponse)
async def read_index():
    return FileResponse("index.html")

@app.post("/api/download")
async def download_video(req: VideoRequest):
    # Trích xuất URL từ văn bản dán vào
    url_match = re.search(r'https?://[^\s]+', req.url)
    if not url_match:
        raise HTTPException(status_code=400, detail="Vui lòng dán liên kết hợp lệ từ RedNote/Xiaohongshu.")
    
    clean_url = url_match.group(0)

    # Giả lập Header trình duyệt đầy đủ kèm Cookie để tránh bị chặn
    headers = {
        "User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
        "Cookie": "webId=1234567890abcdef;"
    }

    try:
        async with httpx.AsyncClient(follow_redirects=True, timeout=20.0, verify=False) as client:
            response = await client.get(clean_url, headers=headers)
            html = response.text

            # 1. Quét tìm link video trực tiếp từ CDN Xiaohongshu (.mp4 hoặc stream cdn)
            video_patterns = [
                r'https?://sns-video-[^\s"\'<>]+',
                r'https?://[^\s"\'<>]+\.mp4[^\s"\'<>]*'
            ]
            
            for pattern in video_patterns:
                matches = re.findall(pattern, html)
                for match in matches:
                    clean_vid_url = match.replace("\\u002F", "/").replace("&amp;", "&").split('"')[0].split("'")[0]
                    if "sns-video" in clean_vid_url or ".mp4" in clean_vid_url:
                        return {
                            "title": "RedNote Video HD",
                            "video_url": clean_vid_url
                        }

            # 2. Phân tích dữ liệu JSON __INITIAL_STATE__
            json_match = re.search(r'window\.__INITIAL_STATE__\s*=\s*({.*?});</script>', html)
            if json_match:
                try:
                    json_str = json_match.group(1).replace("undefined", "null")
                    data = json.loads(json_str)
                    
                    note_data = data.get("note", {}).get("noteDetailMap", {})
                    if note_data:
                        first_key = list(note_data.keys())[0]
                        note = note_data[first_key].get("note", {})
                        
                        title = note.get("title") or note.get("desc") or "RedNote Video"
                        video = note.get("video", {})
                        media = video.get("media", {})
                        stream = media.get("stream", {})
                        
                        video_url = None
                        if "h264" in stream and stream["h264"]:
                            video_url = stream["h264"][0].get("masterUrl")
                        elif "h265" in stream and stream["h265"]:
                            video_url = stream["h265"][0].get("masterUrl")

                        if video_url:
                            return {"title": title[:60], "video_url": video_url}
                except Exception:
                    pass

            raise HTTPException(
                status_code=400, 
                detail="Không thể tìm thấy video. Vui lòng kiểm tra lại xem bài viết này có phải là Video hay bài viết Hình Ảnh."
            )

    except HTTPException as e:
        raise e
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Lỗi kết nối máy chủ: {str(e)}")
